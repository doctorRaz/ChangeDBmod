<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\Shared.props" Condition="Exists('..\Shared.props')" />
	<PropertyGroup>
		<TargetFramework>net48-windows</TargetFramework>
		<Description>Переключалка баз Multicad для AutoCAD 2018+</Description>
		<HostFamily>AC</HostFamily>
		<HostCode>a</HostCode>
	</PropertyGroup>
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);AC</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="AutoCAD.NET" Version="22.0.0">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>
