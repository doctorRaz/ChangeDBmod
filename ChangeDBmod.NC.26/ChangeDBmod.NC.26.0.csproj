<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\Shared.props" Condition="Exists('..\Shared.props')"/>
	<PropertyGroup>
		<TargetFramework>net6.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Description>Переключалка баз Multicad для nanoCAD 26</Description>
		<HostFamily>NC26</HostFamily>
		<HostCode>n</HostCode>
	</PropertyGroup>
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);NC;$(HostFamily)</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="MultiCAD.NET" Version="26.0.7226.4926" />
		<PackageReference Include="nanoCAD.Platform.NET" Version="26.0.7226.4926" />
	</ItemGroup>
</Project>
